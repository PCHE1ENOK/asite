{
  "$meta": {
    "name": "Ai (藍) — дизайн-токены аниме-приложения",
    "version": "0.2.0",
    "updated": "2026-10-29",
    "notes": "Источник правды для темы. Flutter: ColorScheme + ThemeExtension<AppTokens>. Все пары текст/фон проверены на WCAG AA (>= 4.5:1), см. design/README.md."
  },
  "color": {
    "dark": {
      "bg": "#0E1016",
      "surface1": "#161923",
      "surface2": "#1E2230",
      "surface3": "#272C3D",
      "border": "#2C3144",
      "borderStrong": "#3B4159",
      "fg": "#ECEEF5",
      "fg2": "#A7ADC0",
      "fg3": "#878EA4",
      "accent": "#8399FF",
      "accentHover": "#9AACFF",
      "accentPressed": "#6F86F2",
      "onAccent": "#0E1016",
      "accentSoft": "#8399FF26",
      "highlight": "#F2B544",
      "good": "#4CC38A",
      "warn": "#E3A73B",
      "bad": "#F27B7B",
      "scrim": "#000000B3",
      "skeleton": "#1E2230",
      "skeletonShine": "#272C3D"
    },
    "light": {
      "bg": "#F4F5F9",
      "surface1": "#FFFFFF",
      "surface2": "#E9EBF2",
      "surface3": "#DEE1EA",
      "border": "#D9DCE6",
      "borderStrong": "#BFC3D1",
      "fg": "#141722",
      "fg2": "#474D62",
      "fg3": "#646A80",
      "accent": "#3150C9",
      "accentHover": "#2944B3",
      "accentPressed": "#22399A",
      "onAccent": "#FFFFFF",
      "accentSoft": "#3150C91F",
      "highlight": "#94580A",
      "good": "#126F48",
      "warn": "#94580A",
      "bad": "#B9302F",
      "scrim": "#000000B3",
      "skeleton": "#E9EBF2",
      "skeletonShine": "#F4F5F9"
    },
    "listStatus": {
      "$comment": "Статусы списка AniList (MediaListStatus). Порядок фиксирован, проверен валидатором CVD. В UI всегда иконка + подпись, не только цвет.",
      "CURRENT": {
        "label": "Смотрю",
        "icon": "play_circle",
        "light": "#2A78D6",
        "dark": "#3987E5"
      },
      "PLANNING": {
        "label": "В планах",
        "icon": "bookmark",
        "light": "#EB6834",
        "dark": "#D95926"
      },
      "COMPLETED": {
        "label": "Просмотрено",
        "icon": "check_circle",
        "light": "#1BAF7A",
        "dark": "#199E70"
      },
      "PAUSED": {
        "label": "Отложено",
        "icon": "pause_circle",
        "light": "#EDA100",
        "dark": "#C98500"
      },
      "DROPPED": {
        "label": "Брошено",
        "icon": "cancel",
        "light": "#E87BA4",
        "dark": "#D55181"
      },
      "REPEATING": {
        "label": "Пересматриваю",
        "icon": "replay",
        "aliasOf": "CURRENT"
      }
    },
    "score": {
      "$comment": "averageScore AniList (0–100). Порог: >=75 good, 60–74 warn, <60 bad, null — fg3 и «—». Цвет текста берётся из good/warn/bad темы, фон бейджа — тот же цвет с альфой 0x1F.",
      "thresholds": {
        "good": 75,
        "warn": 60
      }
    },
    "adult": {
      "$comment": "Бейдж 18+ (Media.isAdult). Одинаковый в обеих темах, белый текст 5.9:1.",
      "bg": "#B9302F",
      "fg": "#FFFFFF"
    },
    "sync": {
      "$comment": "Состояния синхронизации с приватным GitHub Gist. Цвет иконки берётся из токенов темы, рядом всегда подпись.",
      "synced": {
        "icon": "cloud_done",
        "color": "good",
        "label": "Синхронизировано"
      },
      "pending": {
        "icon": "cloud_upload",
        "color": "warn",
        "label": "Не синхронизировано"
      },
      "syncing": {
        "icon": "sync",
        "color": "fg3",
        "label": "Синхронизация…"
      },
      "error": {
        "icon": "cloud_off",
        "color": "bad",
        "label": "Нет сети"
      },
      "signedOut": {
        "icon": "smartphone",
        "color": "fg3",
        "label": "Только на этом устройстве"
      }
    }
  },
  "typography": {
    "family": {
      "display": "Unbounded",
      "text": "Golos Text",
      "fallback": [
        "Segoe UI Variable",
        "SF Pro Text",
        "system-ui",
        "sans-serif"
      ],
      "$comment": "Оба шрифта OFL, с кириллицей, бандлятся в assets/fonts. Unbounded — только заголовки экранов, название тайтла и крупные числа. Цифры: FontFeature.tabularFigures()."
    },
    "scale": {
      "display": {
        "family": "display",
        "size": 32,
        "line": 40,
        "weight": 600,
        "tracking": -0.5
      },
      "headline": {
        "family": "display",
        "size": 22,
        "line": 28,
        "weight": 600,
        "tracking": -0.2
      },
      "title": {
        "family": "text",
        "size": 18,
        "line": 24,
        "weight": 600
      },
      "body": {
        "family": "text",
        "size": 15,
        "line": 22,
        "weight": 400
      },
      "bodyStrong": {
        "family": "text",
        "size": 15,
        "line": 22,
        "weight": 600
      },
      "label": {
        "family": "text",
        "size": 13,
        "line": 18,
        "weight": 500
      },
      "caption": {
        "family": "text",
        "size": 12,
        "line": 16,
        "weight": 400
      },
      "overline": {
        "family": "text",
        "size": 11,
        "line": 14,
        "weight": 600,
        "tracking": 0.8,
        "case": "upper"
      },
      "scoreLg": {
        "family": "display",
        "size": 28,
        "line": 32,
        "weight": 600,
        "tabular": true
      },
      "timecode": {
        "family": "text",
        "size": 13,
        "line": 16,
        "weight": 500,
        "tabular": true
      }
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "xs": 4,
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 24,
    "pill": 999,
    "$comment": "xs — чипы-метки, sm — кнопки/поля (близко к Win11), md — постеры и карточки, lg — шиты/диалоги, xl — оверлей плеера на iOS."
  },
  "elevation": {
    "dark": {
      "e1": "0 1 2 #00000066",
      "e2": "0 8 24 #00000080",
      "e3": "0 16 48 #000000A0"
    },
    "light": {
      "e1": "0 1 2 #1417221A",
      "e2": "0 8 24 #14172224",
      "e3": "0 16 48 #1417222E"
    }
  },
  "layout": {
    "breakpoints": {
      "compact": 0,
      "medium": 640,
      "expanded": 1008,
      "large": 1440
    },
    "navRail": {
      "collapsed": 72,
      "expanded": 248
    },
    "gutter": {
      "compact": 16,
      "medium": 24,
      "expanded": 32
    },
    "poster": {
      "aspect": "2:3",
      "minWidth": 148,
      "maxWidth": 220,
      "gap": {
        "compact": 12,
        "expanded": 20
      }
    },
    "contentMaxWidth": 1600,
    "titleBar": {
      "windows": 32
    }
  },
  "motion": {
    "duration": {
      "instant": 80,
      "fast": 150,
      "base": 220,
      "slow": 320,
      "overlayHide": 3000
    },
    "easing": {
      "standard": "cubic(0.2, 0, 0, 1)",
      "decelerate": "cubic(0, 0, 0, 1)",
      "accelerate": "cubic(0.3, 0, 1, 1)"
    },
    "$comment": "При reduce motion — только opacity, без сдвигов и scale."
  },
  "state": {
    "hoverOverlay": 0.06,
    "pressedOverlay": 0.12,
    "selectedOverlay": 0.1,
    "disabledOpacity": 0.38,
    "focusRing": {
      "width": 2,
      "offset": 2,
      "color": "accent"
    },
    "posterHoverScale": 1.03
  },
  "platforms": {
    "windows": {
      "nav": "NavigationRail",
      "titleBar": 32,
      "backdrop": "Mica только на Windows 11, иначе сплошной bg"
    },
    "ios": {
      "nav": "нижний таб-бар",
      "backdrop": "сплошной bg",
      "minTarget": 44
    },
    "android": {
      "nav": "NavigationBar (Material 3), системный жест «назад»",
      "backdrop": "сплошной bg",
      "minTarget": 48
    },
    "icons": "Material Symbols Rounded (пакет material_symbols_icons), weight 400, fill 0; fill 1 для выбранного пункта навигации"
  }
}
